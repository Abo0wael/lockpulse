{
  "phase": 1,
  "defaults": {
    "interval_ms": 5,
    "watchdog_ms": 3000,
    "max_ms": 10000
  },
  "seeds": [
    1,
    2,
    3
  ],
  "families": {
    "two_lock_inversion": {
      "binary": "build/bench/two_lock_inversion",
      "outcome": "hang",
      "hang_kind": "deadlock",
      "expected_exit": "watchdog_kill",
      "params": {}
    },
    "lost_wakeup": {
      "binary": "build/bench/lost_wakeup",
      "outcome": "hang",
      "hang_kind": "lost_wakeup",
      "expected_exit": "watchdog_kill",
      "params": {}
    },
    "high_contention": {
      "binary": "build/bench/high_contention",
      "outcome": "healthy",
      "expected_exit": "exited_ok",
      "params": {
        "threads": 16,
        "cs_us": 80,
        "work_ms": 1500,
        "rate": 700,
        "iters": 4000
      }
    },
    "long_critical_section": {
      "binary": "build/bench/long_critical_section",
      "outcome": "healthy",
      "hard_negative": true,
      "expected_exit": "exited_ok",
      "params": {
        "threads": 4,
        "work_ms": 400
      },
      "watchdog_ms": 4000,
      "_note": "cs_us omitted on purpose: the benchmark draws the hold time from the seed in [1.0, 2.5] s"
    }
  },
  "overhead": {
    "family": "high_contention",
    "seed": 1,
    "params": {
      "threads": 16,
      "cs_us": 0,
      "work_ms": 0,
      "rate": 0,
      "iters": 10000
    },
    "_note": "fixed-work mode (work_ms 0, rate 0, iters per thread): elapsed time and ops/s measure tracing cost; the time-bounded params above are for the gate's PF runs"
  }
}
