        {"id": "c1", "params": {"threads": 4, "cs_us": 0,       "work_ms": 400, "rate": 200}},
        {"id": "c2", "params": {"threads": 8, "cs_us": 0,       "work_ms": 600, "rate": 100}},
        {"id": "c3", "params": {"threads": 2, "cs_us": 0,       "work_ms": 300, "rate": 500}},
        {"id": "c4", "params": {"threads": 6, "cs_us": 2000000, "work_ms": 400, "rate": 200}}
