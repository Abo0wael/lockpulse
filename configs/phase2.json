{
  "phase": 2,
  "_doc": [
    "13 families x 4 configs x 15 seeds = 780 runs, all with --tier PF.",
    "split follows the guide's table; all runs of a family stay in its split.",
    "Hang families: c1-c3 use --force 1 (bug guaranteed), c4 uses --force 0 (scheduler decides).",
    "c1 of every family is the one check-phase2 runs (seed 1).",
    "params map to benchmark flags: key cs_us -> --cs-us etc.; see each bench/*.c header for meaning.",
    "watchdog_ms is 3000 everywhere except long_critical_section (see its _watchdog_note)."
  ],
  "defaults": {
    "interval_ms": 5,
    "watchdog_ms": 3000,
    "max_ms": 6000
  },
  "seeds": {"first": 1, "last": 15},
  "families": {
    "two_lock_inversion": {
      "binary": "build/bench/two_lock_inversion",
      "split": "train",
      "kind": "hang",
      "hang_type": "deadlock",
      "configs": [
        {"id": "c1", "params": {"threads": 2, "cs_us": 0,   "work_ms": 400,  "rate": 200, "force": 1}},
        {"id": "c2", "params": {"threads": 4, "cs_us": 100, "work_ms": 800,  "rate": 500, "force": 1}},
        {"id": "c3", "params": {"threads": 8, "cs_us": 50,  "work_ms": 1200, "rate": 100, "force": 1}},
        {"id": "c4", "params": {"threads": 2, "cs_us": 300, "work_ms": 400,  "rate": 200, "iters": 300, "force": 0}}
      ]
    },
    "three_thread_cycle": {
      "binary": "build/bench/three_thread_cycle",
      "split": "validation",
      "kind": "hang",
      "hang_type": "deadlock",
      "configs": [
        {"id": "c1", "params": {"threads": 3, "cs_us": 0,   "work_ms": 400,  "rate": 200, "force": 1}},
        {"id": "c2", "params": {"threads": 4, "cs_us": 100, "work_ms": 800,  "rate": 500, "force": 1}},
        {"id": "c3", "params": {"threads": 6, "cs_us": 50,  "work_ms": 1200, "rate": 100, "force": 1}},
        {"id": "c4", "params": {"threads": 3, "cs_us": 300, "work_ms": 400,  "rate": 200, "iters": 300, "force": 0}}
      ]
    },
    "dining_philosophers": {
