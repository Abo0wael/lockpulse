        {"id": "c2", "params": {"threads": 4,  "cs_us": 50,  "work_ms": 2000, "rate": 300, "iters": 4}},
        {"id": "c3", "params": {"threads": 16, "cs_us": 10,  "work_ms": 2000, "rate": 200, "iters": 16}},
