        {"id": "c2", "params": {"threads": 2, "cs_us": 50,  "work_ms": 800,  "rate": 0, "iters": 40, "force": 1}},
        {"id": "c3", "params": {"threads": 6, "cs_us": 200, "work_ms": 1200, "rate": 0, "iters": 20, "force": 1}},
        {"id": "c4", "params": {"threads": 4, "cs_us": 800, "work_ms": 600,  "rate": 0, "iters": 30, "force": 0}}
