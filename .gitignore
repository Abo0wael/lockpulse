# build outputs / artifact staging
build/
dist/

# downloaded datasets (e.g. data/collect1/ from the collect workflow) and the ML venv
data/collect*/
.venv/

# phase-3 fitted models (binary, scikit-learn-version specific; rebuilt by make phase3)
results/phase3/models/

# data: directory skeleton is tracked, contents are not
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep

# generated reports (regenerated on every run; CI uploads them as artifacts)
results/check_phase*_*.txt
results/collect_*.txt
results/labels_summary.txt
results/overhead.csv
results/overhead_runs.csv
results/review.md

# python
__pycache__/
*.pyc

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
